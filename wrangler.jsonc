{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dormparcel",
  "main": "worker.ts",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 11 * * *"]
  }
}
